{
  "name": "livecomplexity",
  "displayName": "LiveComplexity: Real-time Big-O Analysis",
  "description": "Instantly analyze and display Big-O time complexity for C++ loops and functions inline as you type.",
  "version": "0.1.0",
  "publisher": "livecomplexity",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Linters"
  ],
  "keywords": [
    "c++",
    "cpp",
    "complexity",
    "big-o",
    "algorithm",
    "time complexity"
  ],
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/livecomplexity/livecomplexity-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/livecomplexity/livecomplexity-vscode/issues"
  },
  "homepage": "https://github.com/livecomplexity/livecomplexity-vscode#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:cpp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "livecomplexity.showOutput",
        "title": "LiveComplexity: Show Output"
      }
    ],
    "configuration": {
      "title": "LiveComplexity",
      "properties": {
        "liveComplexity.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable LiveComplexity analysis globally across the workspace."
        },
        "liveComplexity.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 2000,
          "description": "Delay (ms) before analysis runs after you stop typing. Increase this on slower machines to prevent editor lag."
        },
        "liveComplexity.showInlineAnnotations": {
          "type": "boolean",
          "default": true,
          "description": "Display Big-O time complexity annotations inline at the end of function and loop declarations."
        },
        "liveComplexity.showHover": {
          "type": "boolean",
          "default": true,
          "description": "Show detailed mathematical breakdowns of loop complexity when hovering over function or loop signatures."
        },
        "liveComplexity.maxFileSizeKB": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Safety limit: Skip AST analysis for files larger than this size (KB) to maintain editor performance."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.0.0",
    "web-tree-sitter": "^0.20.8"
  }
}
